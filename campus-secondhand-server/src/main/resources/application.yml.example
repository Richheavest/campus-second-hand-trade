# 复制本文件为 application.yml 并填入你的本地数据库密码后再启动。
# （application.yml 已被 .gitignore 忽略，避免泄露数据库密码）

server:
  port: 8080

spring:
  application:
    name: campus-secondhand
  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 20MB
  datasource:
    url: jdbc:mysql://localhost:3306/campus_secondhand?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: 请替换为你的MySQL密码
    driver-class-name: com.mysql.cj.jdbc.Driver
    hikari:
      minimum-idle: 5
      maximum-pool-size: 20
  jackson:
    date-format: yyyy-MM-dd HH:mm:ss
    time-zone: Asia/Shanghai
  data:
    redis:
      host: localhost
      port: 6379
      database: 0
      timeout: 5000ms
      lettuce:
        pool:
          max-active: 8
          max-idle: 8
          min-idle: 0

# 微信小程序登录配置（真实登录需填 appid/secret；dev-mode=true 时用本地 mock openid 兜底）
wechat:
  appid: 请替换为小程序AppID
  secret: 请替换为小程序AppSecret
  dev-mode: true

# JWT 配置（生产环境请更换为随机密钥）
jwt:
  secret: 请替换为至少32字节的随机密钥
  expire-hours: 168

mybatis-plus:
  mapper-locations: classpath:/mapper/*.xml
  type-aliases-package: com.campus.secondhand.entity
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
  global-config:
    db-config:
      id-type: auto
      logic-delete-field: deleted
      logic-delete-value: 1
      logic-not-delete-value: 0

# 文件上传配置
upload:
  path: ./uploads/
  max-size: 10MB
