<!-- 订单详情 -->
<view class="page" wx:if="{{order}}">
  <!-- 状态横幅 -->
  <view class="status-banner" style="background: linear-gradient(135deg, {{order.statusColor}}, {{order.statusColor}}dd);">
    <text class="status-icon">{{order.statusIcon}}</text>
    <text class="status-title">{{order.statusLabel}}</text>
    <text class="status-sub" wx:if="{{order.status === 'pending'}}">请尽快付款，超时将自动取消</text>
    <text class="status-sub" wx:if="{{order.status === 'paid'}}">等待卖家发货</text>
    <text class="status-sub" wx:if="{{order.status === 'shipped'}}">商品正在路上，请注意收货</text>
    <text class="status-sub" wx:if="{{order.status === 'received'}}">交易已完成</text>
  </view>

  <!-- 商品信息 -->
  <view class="section card">
    <view class="section-title">商品信息</view>
    <view class="flex-align-center" bindtap="onTapProduct" data-id="{{order.product.id}}">
      <image class="product-img" src="{{order.product.images[0]}}" mode="aspectFill" />
      <view class="flex-1 ml-sm">
        <text class="product-title text-ellipsis-2">{{order.product.title}}</text>
        <text class="text-price text-lg mt-xs">¥{{order.totalPrice}}</text>
      </view>
    </view>
  </view>

  <!-- 价格明细 -->
  <view class="section card">
    <view class="section-title">价格明细</view>
    <view class="price-row flex-between">
      <text class="text-secondary">商品金额</text>
      <text>¥{{order.price}}</text>
    </view>
    <view class="price-row flex-between">
      <text class="text-secondary">运费</text>
      <text>{{order.freight > 0 ? '¥' + order.freight : '免运费'}}</text>
    </view>
    <view class="price-row flex-between total">
      <text>实付金额</text>
      <text class="text-price text-lg">¥{{order.totalPrice}}</text>
    </view>
  </view>

  <!-- 买卖双方 -->
  <view class="section card">
    <view class="flex-between">
      <view class="user-side">
        <text class="text-sm text-secondary">卖家</text>
        <view class="flex-align-center mt-sm">
          <image class="user-avatar" src="{{order.seller.avatarUrl || '/images/avatar/avatar1.png'}}" mode="aspectFill" />
          <text class="ml-sm">{{order.seller.nickName || '未知用户'}}</text>
        </view>
      </view>
      <text class="arrow-icon">⇄</text>
      <view class="user-side text-right">
        <text class="text-sm text-secondary">买家</text>
        <view class="flex-align-center mt-sm" style="justify-content: flex-end;">
          <text class="mr-sm">{{order.buyer.nickName || '未知用户'}}</text>
          <image class="user-avatar" src="{{order.buyer.avatarUrl || '/images/avatar/avatar1.png'}}" mode="aspectFill" />
        </view>
      </view>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="section card">
    <view class="section-title">订单信息</view>
    <view class="info-row flex-between">
      <text class="text-secondary">订单编号</text>
      <text class="text-sm">{{order.id}}</text>
    </view>
    <view class="info-row flex-between">
      <text class="text-secondary">创建时间</text>
      <text class="text-sm">{{order.createTime}}</text>
    </view>
    <!-- 状态时间线 -->
    <view class="timeline">
      <view class="timeline-item {{t.status === order.status ? 'active' : ''}}"
            wx:for="{{order.statusTimeline}}" wx:key="index">
        <view class="timeline-dot"></view>
        <view class="ml-sm">
          <text class="text-sm">{{timelineLabel(t.status)}}</text>
          <text class="text-xs text-light ml-sm">{{t.time}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="bottom-bar" wx:if="{{order.status !== 'received' && order.status !== 'cancelled'}}">
    <button class="btn btn-outline flex-1" wx:if="{{order.status === 'pending'}}"
            bindtap="onCancel">取消订单</button>
    <button class="btn btn-primary flex-1 ml-sm" wx:if="{{order.status === 'pending'}}"
            bindtap="onPay">立即付款</button>
    <button class="btn btn-primary btn-block" wx:if="{{order.status === 'shipped'}}"
            bindtap="onConfirm">确认收货</button>
    <view class="flex-1" wx:if="{{order.status === 'paid'}}">
      <text class="text-light text-sm">等待卖家发货...</text>
    </view>
  </view>
</view>
