/* 订单列表 */
.page {
  min-height: 100vh;
  background: #F5F5F5;
}

/* Tab */
.tab-bar {
  display: flex;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}
.tab-item.active {
  color: #D4A017;
  font-weight: 600;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #FFD100;
  border-radius: 3rpx;
}

/* 订单卡片 */
.order-card {
  margin: 12rpx 24rpx;
  padding: 0;
  overflow: hidden;
}
.order-header {
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.order-status {
  font-size: 26rpx;
  font-weight: 600;
}
.order-product {
  padding: 16rpx 20rpx;
  display: flex;
}
.order-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.order-title {
  font-size: 26rpx;
  color: #1A1A1A;
  line-height: 1.5;
}
.order-actions, .order-footer {
  padding: 16rpx 20rpx;
  border-top: 1rpx solid #f5f5f5;
}
.action-btns {
  display: flex;
  gap: 12rpx;
}
.btn-sm {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 32rpx;
  line-height: 1.5;
  border: none;
}
.btn-sm::after { border: none; }
.btn-primary.btn-sm {
  background: #FFD100;
  color: #1A1A1A;
}
.btn-outline.btn-sm {
  background: #fff;
  color: #999;
  border: 1rpx solid #ddd;
}

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}
.empty-icon { font-size: 100rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; color: #666; }
