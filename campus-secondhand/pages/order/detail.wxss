/* 订单详情 */
.page {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 120rpx;
}

/* 状态横幅 */
.status-banner {
  padding: 48rpx 32rpx;
  color: #fff;
  text-align: center;
}
.status-icon {
  font-size: 64rpx;
  display: block;
  margin-bottom: 12rpx;
}
.status-title {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
}
.status-sub {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 8rpx;
  display: block;
}

/* 公共区块 */
.section {
  margin: 12rpx 24rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.product-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.product-title {
  font-size: 26rpx;
  color: #1A1A1A;
}

.price-row {
  padding: 10rpx 0;
  font-size: 26rpx;
}
.price-row.total {
  border-top: 1rpx solid #f5f5f5;
  padding-top: 16rpx;
  margin-top: 8rpx;
  font-weight: 600;
}

/* 用户信息 */
.user-side { flex: 1; }
.user-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
}
.arrow-icon {
  font-size: 32rpx;
  color: #FFD100;
  padding: 0 24rpx;
}

/* 订单信息 */
.info-row {
  padding: 8rpx 0;
  font-size: 26rpx;
}

/* 时间线 */
.timeline {
  margin-top: 16rpx;
  padding-left: 8rpx;
}
.timeline-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  position: relative;
}
.timeline-item::before {
  content: '';
  position: absolute;
  left: 7rpx;
  top: 36rpx;
  bottom: -12rpx;
  width: 2rpx;
  background: #eee;
}
.timeline-item:last-child::before { display: none; }
.timeline-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ddd;
  flex-shrink: 0;
}
.timeline-item.active .timeline-dot {
  background: #FFD100;
  box-shadow: 0 0 0 6rpx rgba(255, 209, 0, 0.2);
}
.timeline-item.active {
  font-weight: 500;
}

/* 底部 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  gap: 16rpx;
}
