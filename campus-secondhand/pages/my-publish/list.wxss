.page { min-height: 100vh; background: #fff; }
.product-item {
  display: flex;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.product-img {
  width: 140rpx; height: 140rpx;
  border-radius: 12rpx; flex-shrink: 0;
}
.product-title { font-size: 28rpx; color: #1A1A1A; line-height: 1.5; }
.status-tag {
  font-size: 22rpx; padding: 2rpx 12rpx; border-radius: 6rpx;
}
.status-tag.on_sale { background: #F6FFED; color: #52C41A; }
.status-tag.sold { background: #F5F5F5; color: #999; }
.status-tag.off_shelf { background: #FFF1F0; color: #FF4D4F; }
.meta-text { font-size: 22rpx; color: #999; }
.action-text {
  font-size: 24rpx; color: #FFD100; padding: 4rpx 12rpx;
}
.action-text.danger { color: #FF4D4F; }
.action-text.disabled { color: #ccc; }

.empty-wrap {
  display: flex; flex-direction: column; align-items: center; padding-top: 200rpx;
}
.empty-icon { font-size: 100rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; color: #666; margin-bottom: 8rpx; }
.empty-sub { font-size: 24rpx; }
