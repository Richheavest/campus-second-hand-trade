/* 发布商品页 */
.page {
  min-height: 100vh;
  background: #F5F5F5;
}

/* 图片区 */
.image-section {
  background: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}
.upload-img {
  width: 100%;
  height: 100%;
}
.image-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}
.image-index {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0,0,0,0.45);
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  padding: 4rpx;
}
.image-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fafafa;
}
.add-icon {
  font-size: 52rpx;
  margin-bottom: 8rpx;
}
.add-text {
  font-size: 22rpx;
  color: #999;
}
.image-tip {
  margin-top: 16rpx;
}

/* 表单区 */
.form-section {
  background: #fff;
}
.form-item {
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-label {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
}
.required {
  color: #FF4D4F;
}
.form-input {
  font-size: 28rpx;
  width: 100%;
}
.form-textarea {
  font-size: 28rpx;
  width: 100%;
  min-height: 140rpx;
  line-height: 1.6;
}
.char-count {
  text-align: right;
  margin-top: 8rpx;
}
.price-input-wrap {
  display: flex;
  align-items: center;
}
.price-prefix {
  font-size: 40rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-right: 8rpx;
}
.price-input {
  flex: 1;
  font-size: 40rpx;
  font-weight: 600;
}
.picker-value {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #1A1A1A;
}
.placeholder {
  color: #ccc;
}
.arrow {
  font-size: 36rpx;
  color: #ccc;
  margin-left: 8rpx;
}

/* 提交 */
.submit-section {
  padding: 32rpx 24rpx;
}
.btn.disabled {
  background: #e0e0e0;
  color: #999;
}
