.page { min-height: 100vh; background: #fff; }
.fav-item { padding: 20rpx 24rpx; border-bottom: 1rpx solid #f5f5f5; }
.fav-img { width: 140rpx; height: 140rpx; border-radius: 12rpx; flex-shrink: 0; }
.fav-title { font-size: 28rpx; color: #1A1A1A; line-height: 1.5; }
.unfavorite-btn {
  font-size: 24rpx; color: #FF4D4F; padding: 8rpx 16rpx;
  border: 1rpx solid #FF4D4F; border-radius: 24rpx; flex-shrink: 0;
}
.empty-wrap { display: flex; flex-direction: column; align-items: center; padding-top: 200rpx; }
.empty-icon { font-size: 100rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; color: #666; margin-bottom: 8rpx; }
.empty-sub { font-size: 24rpx; }
