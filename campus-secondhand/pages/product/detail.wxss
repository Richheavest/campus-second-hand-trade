/* 商品详情页 */
.page {
  min-height: 100vh;
  background: #F5F5F5;
}

/* ===== 图片轮播 ===== */
.img-swiper {
  width: 100%;
  height: 750rpx;
  background: #eee;
}
.swiper-img {
  width: 100%;
  height: 100%;
}

/* ===== 价格区 ===== */
.price-section {
  margin-top: 0;
  border-radius: 0 0 16rpx 16rpx;
}
.price-symbol {
  font-size: 32rpx;
  color: #FF4D4F;
  font-weight: 600;
}
.price-current {
  font-size: 52rpx;
  color: #FF4D4F;
  font-weight: 700;
  line-height: 1;
}
.price-decimal {
  font-size: 32rpx;
  color: #FF4D4F;
  font-weight: 600;
}
.price-original {
  font-size: 26rpx;
  color: #999;
  text-decoration: line-through;
  margin-left: 12rpx;
}
.status-badge {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}
.status-badge.on_sale {
  background: #F6FFED;
  color: #52C41A;
  border: 1rpx solid #B7EB8F;
}
.status-badge.sold {
  background: #F5F5F5;
  color: #999;
}

/* ===== 标签 ===== */
.tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
}
.tag-primary {
  background: #FFF3CD;
  color: #D4A017;
}
.tag-outline {
  background: #fff;
  color: #666;
  border: 1rpx solid #eee;
}
.tag-category {
  background: #F5F5F5;
  color: #999;
}

/* ===== 商品信息 ===== */
.info-section {
  margin-top: 16rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  line-height: 1.5;
}
.section-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  margin-top: 16rpx;
}
.meta-item {
  font-size: 24rpx;
  color: #999;
}

/* ===== 卖家卡片 ===== */
.seller-section {
  margin-top: 16rpx;
}
.seller-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.seller-name {
  font-size: 30rpx;
  font-weight: 600;
}
.credit-badge {
  background: #FFF3CD;
  color: #D4A017;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
  margin-left: 10rpx;
}
.arrow {
  font-size: 40rpx;
  color: #ccc;
}
/* 卖家其他商品 */
.seller-product-item {
  display: inline-block;
  margin-right: 16rpx;
  text-align: center;
}
.sp-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  display: block;
  margin-bottom: 6rpx;
}

/* ===== 底部操作栏 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background: #fff;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  z-index: 100;
}
.bar-left {
  flex-shrink: 0;
  margin-right: 16rpx;
}
.bar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 16rpx;
}
.bar-btn.favorited .bar-icon,
.bar-btn.favorited .bar-text {
  color: #FF4D4F;
}
.bar-icon {
  font-size: 40rpx;
}
.bar-text {
  font-size: 20rpx;
  color: #999;
}
.bar-right {
  flex: 1;
  display: flex;
  gap: 16rpx;
}
.action-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
  font-weight: 600;
}
.action-btn::after { border: none; }
.btn-chat {
  background: #FFF3CD;
  color: #D4A017;
}
.btn-buy {
  background: linear-gradient(135deg, #FFD100, #FFC107);
  color: #1A1A1A;
}
