/* 首页样式 */
.page {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ===== 搜索栏 ===== */
.search-bar {
  padding: 16rpx 24rpx;
  background: #FFD100;
  position: sticky;
  top: 0;
  z-index: 100;
}
.search-input {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}
.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}
.search-placeholder {
  color: #999;
  font-size: 28rpx;
}

/* ===== 分类宫格 ===== */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  background: #fff;
  padding: 24rpx 8rpx 16rpx;
  margin-bottom: 16rpx;
}
.category-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 6rpx 0;
}
.category-icon-wrap {
  width: 92rpx;
  height: 92rpx;
  border-radius: 26rpx;
  background: #F7F8FA;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
  transition: all 0.2s;
}
.category-icon {
  font-size: 46rpx;
  line-height: 1;
}
.category-name {
  font-size: 24rpx;
  color: #666;
}
.category-item.active .category-icon-wrap {
  background: #FFD100;
  box-shadow: 0 8rpx 20rpx rgba(255, 209, 0, 0.45);
}
.category-item.active .category-name {
  color: #E6A800;
  font-weight: 600;
}

/* ===== 排序栏 ===== */
.sort-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #fff;
  margin-bottom: 2rpx;
}
.sort-tabs {
  display: flex;
  gap: 24rpx;
}
.sort-item {
  font-size: 26rpx;
  color: #666;
  padding: 4rpx 0;
  position: relative;
}
.sort-item.active {
  color: #E6A800;
  font-weight: 600;
}
.sort-item.active::after {
  content: '';
  position: absolute;
  bottom: -4rpx;
  left: 0;
  right: 0;
  height: 4rpx;
  background: #FFD100;
  border-radius: 2rpx;
}

/* ===== 瀑布流 ===== */
.waterfall-wrap {
  display: flex;
  padding: 16rpx 12rpx;
  gap: 12rpx;
}
.waterfall-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.waterfall-item {
  width: 100%;
}

/* ===== 空状态 ===== */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}
.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}
.empty-sub {
  font-size: 24rpx;
}

/* ===== 加载更多 ===== */
.load-more {
  text-align: center;
  padding: 32rpx;
}
