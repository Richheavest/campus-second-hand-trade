/* 消息列表 */
.page {
  min-height: 100vh;
  background: #fff;
}

.chat-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background 0.2s;
}
.chat-item:active { background: #fafafa; }

.avatar-wrap {
  position: relative;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.chat-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
}
.unread-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  background: #FF4D4F;
  color: #fff;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 16rpx;
  padding: 0 8rpx;
}

.chat-info {
  overflow: hidden;
}
.chat-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1A1A1A;
}
.chat-time {
  flex-shrink: 0;
  margin-left: 12rpx;
}
.chat-lastmsg {
  margin-top: 8rpx;
}

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}
.empty-icon { font-size: 100rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; color: #666; margin-bottom: 8rpx; }
.empty-sub { font-size: 24rpx; }
