<!-- 商品卡片组件 -->
<view class="product-card" bindtap="onTap" wx:if="{{product}}">
  <!-- 商品封面图 -->
  <view class="card-image-wrap">
    <image class="card-image" src="{{product.images[0]}}" mode="widthFix" binderror="onImageError" />
    <!-- 状态标签 -->
    <view class="status-tag" wx:if="{{product.status === 'sold'}}">已售</view>
    <!-- 多图标识 -->
    <view class="image-count" wx:if="{{product.images.length > 1}}">
      <text>{{product.images.length}}图</text>
    </view>
  </view>

  <!-- 商品信息 -->
  <view class="card-body">
    <!-- 标题 -->
    <view class="card-title text-ellipsis-2">{{product.title}}</view>

    <!-- 价格行 -->
    <view class="card-price-row flex-between">
      <view class="flex-align-center">
        <text class="price-symbol">¥</text>
        <text class="card-price">{{priceInt}}</text>
        <text class="price-decimal" wx:if="{{priceDecimal}}">.{{priceDecimal}}</text>
        <text class="original-price" wx:if="{{product.originalPrice}}">¥{{product.originalPrice}}</text>
      </view>
    </view>

    <!-- 卖家 & 时间 -->
    <view class="card-footer flex-between">
      <view class="flex-align-center">
        <image class="seller-avatar" src="{{product.seller.avatarUrl || '/images/avatar/avatar1.png'}}" mode="aspectFill" />
        <text class="seller-name text-ellipsis">{{product.seller.nickName || '未知用户'}}</text>
      </view>
      <text class="card-time text-light text-xs">{{timeText}}</text>
    </view>
  </view>
</view>

<!-- 占位骨架 -->
<view class="product-card skeleton" wx:else>
  <view class="card-image-wrap skeleton-bg"></view>
  <view class="card-body">
    <view class="skeleton-line skeleton-line-1"></view>
    <view class="skeleton-line skeleton-line-2"></view>
  </view>
</view>
